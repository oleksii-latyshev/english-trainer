{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": { "@/*": ["./src/*"] },
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@playwright/test", "node"],
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["playwright.config.ts", "e2e/**/*.ts"]
}
