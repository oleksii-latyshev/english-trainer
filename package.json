{
  "name": "english-trainer",
  "private": true,
  "packageManager": "bun@1.4.0",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "dev:browser": "vite --open",
    "build": "tsc && vite build",
    "build:icons": "bun run scripts/build-icons.ts",
    "build:desktop": "sh ./scripts/build-macos.sh",
    "preview": "vite preview",
    "tauri": "tauri",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "check:rust": "sh ./scripts/check-rust.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test --pass-with-no-tests",
    "test:e2e": "playwright test",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "verify": "sh ./scripts/verify.sh",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "prepare": "lefthook install",
    "check:effect": "effect-language-service diagnostics --project tsconfig.json --strict",
    "check:conventions": "bun run scripts/check-conventions.ts",
    "repo:taxonomy": "bun scripts/repo-taxonomy.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@effect/atom-react": "4.0.2",
    "@tanstack/react-router": "^1.170.41",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "effect": "4.0.2",
    "lucide-react": "^1.53.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-variants": "3.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@effect/language-service": "0.87.4",
    "@playwright/test": "^1.58.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/bun": "1.4.2",
    "@types/node": "^26.6.4",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.1.2",
    "lefthook": "^2.2.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.3.3"
  },
  "license": "AGPL-3.0-or-later"
}
