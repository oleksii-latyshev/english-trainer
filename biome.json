{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/target",
      "!bun.lock",
      "!src-tauri/gen",
      "!src/core/ipc/bindings"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noExplicitAny": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["warn", "error"]
          }
        },
        "noReactForwardRef": "error",
        "noNestedPromises": "error"
      },
      "style": {
        "noNonNullAssertion": "error",
        "useConst": "error",
        "noParameterAssign": "error",
        "useBlockStatements": "off",
        "noExcessiveLinesPerFile": {
          "level": "error",
          "options": {
            "maxLines": 300
          }
        }
      },
      "complexity": {
        "noExcessiveCognitiveComplexity": {
          "level": "warn",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "nursery": {
        "noFloatingPromises": "error",
        "noMisusedPromises": "error",
        "useExhaustiveSwitchCases": "error",
        "noComponentHookFactories": "error",
        "noReactStringRefs": "error",
        "useAwaitThenable": "error",
        "noPlaywrightMissingAwait": "error",
        "noPlaywrightUselessAwait": "error",
        "useTestHooksOnTop": "error"
      },
      "correctness": {
        "noNestedComponentDefinitions": "error",
        "noReactPropAssignments": "error"
      }
    },
    "domains": {
      "react": "recommended",
      "test": "recommended",
      "playwright": "recommended",
      "project": "recommended"
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "overrides": [
    {
      "includes": ["tsconfig*.json", ".vscode/*.json"],
      "json": {
        "parser": {
          "allowComments": true
        }
      }
    },
    {
      "includes": [
        "src/app/**",
        "src/screens/**",
        "src/features/**",
        "src/core/**",
        "src/shared/**",
        "!src/features/coach/**",
        "!src/features/conversation/**",
        "!src/features/memory/**",
        "!src/features/practice/**",
        "!src/features/settings/**",
        "!src/app/speech-capture/use-speech-capture.ts"
      ],
      "plugins": ["./biome/plugins/function-declarations.grit"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["kebab-case"],
                "requireAscii": true
              }
            },
            "noDefaultExport": "error",
            "useConsistentTypeDefinitions": {
              "level": "error",
              "options": {
                "style": "type"
              }
            },
            "noEnum": "error",
            "noNestedTernary": "error",
            "useImportType": "error",
            "useExportType": "error"
          },
          "performance": {
            "noReExportAll": "error",
            "noBarrelFile": "off"
          },
          "suspicious": {
            "noImportCycles": "error"
          },
          "correctness": {
            "noUnusedImports": "error"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": {
              "level": "error",
              "options": {
                "maxAllowedComplexity": 12
              }
            },
            "noExcessiveLinesPerFunction": {
              "level": "error",
              "options": {
                "maxLines": 80
              }
            }
          },
          "nursery": {
            "useSortedClasses": {
              "level": "error",
              "fix": "safe",
              "options": {
                "functions": ["tv", "clsx", "cn"]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/app/**",
        "src/screens/**",
        "src/features/**",
        "src/core/**",
        "src/shared/**",
        "!src/features/coach/**",
        "!src/features/conversation/**",
        "!src/features/memory/**",
        "!src/features/practice/**",
        "!src/features/settings/**",
        "!src/app/**",
        "!**/*.test.ts",
        "!**/*.test.tsx",
        "!**/tests/**"
      ],
      "plugins": [
        "./biome/plugins/no-effect-run.grit",
        "./biome/plugins/no-promise-control-flow.grit"
      ]
    },
    {
      "includes": ["src/shared/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/screens/**",
                      "@/features/**",
                      "@/core/**",
                      "@/app",
                      "@/screens",
                      "@/features",
                      "@/core"
                    ],
                    "message": "shared/ is the bottom layer and imports nothing above it."
                  },
                  {
                    "group": [
                      "@/lib/**",
                      "@/components/**",
                      "@/routes/**",
                      "@/context/**",
                      "@/features/coach/**",
                      "@/features/conversation/**",
                      "@/features/memory/**",
                      "@/features/practice/**",
                      "@/features/settings/**",
                      "@/features/coach",
                      "@/features/conversation",
                      "@/features/memory",
                      "@/features/practice",
                      "@/features/settings"
                    ],
                    "message": "New layers never import legacy folders; migrate the code first (docs/engineering/MIGRATION.md)."
                  },
                  {
                    "group": ["@tauri-apps/api/core"],
                    "message": "Only core/ipc calls invoke(); use the Ipc service (EFFECT.md \u00a72)."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/screens/**",
                      "@/features/**",
                      "@/app",
                      "@/screens",
                      "@/features"
                    ],
                    "message": "core/ never imports app/, screens/ or features/."
                  },
                  {
                    "group": [
                      "@/lib/**",
                      "@/components/**",
                      "@/routes/**",
                      "@/context/**",
                      "@/features/coach/**",
                      "@/features/conversation/**",
                      "@/features/memory/**",
                      "@/features/practice/**",
                      "@/features/settings/**",
                      "@/features/coach",
                      "@/features/conversation",
                      "@/features/memory",
                      "@/features/practice",
                      "@/features/settings"
                    ],
                    "message": "New layers never import legacy folders; migrate the code first (docs/engineering/MIGRATION.md)."
                  },
                  {
                    "group": ["@tauri-apps/api/core"],
                    "message": "Only core/ipc calls invoke(); use the Ipc service (EFFECT.md \u00a72)."
                  },
                  {
                    "group": ["@/shared/*/*/**"],
                    "message": "Import the public API (`@/features/x`, `@/core/x`, `@/shared/ui/x`), not a deep path."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/core/ipc/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/screens/**",
                      "@/features/**",
                      "@/app",
                      "@/screens",
                      "@/features"
                    ],
                    "message": "core/ never imports app/, screens/ or features/."
                  },
                  {
                    "group": [
                      "@/lib/**",
                      "@/components/**",
                      "@/routes/**",
                      "@/context/**",
                      "@/features/coach/**",
                      "@/features/conversation/**",
                      "@/features/memory/**",
                      "@/features/practice/**",
                      "@/features/settings/**",
                      "@/features/coach",
                      "@/features/conversation",
                      "@/features/memory",
                      "@/features/practice",
                      "@/features/settings"
                    ],
                    "message": "New layers never import legacy folders; migrate the code first (docs/engineering/MIGRATION.md)."
                  },
                  {
                    "group": ["@/shared/*/*/**"],
                    "message": "Import the public API (`@/features/x`, `@/core/x`, `@/shared/ui/x`), not a deep path."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/features/**",
        "!src/features/coach/**",
        "!src/features/conversation/**",
        "!src/features/memory/**",
        "!src/features/practice/**",
        "!src/features/settings/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@/app/**",
                      "@/screens/**",
                      "@/features/**",
                      "@/app",
                      "@/screens",
                      "@/features"
                    ],
                    "message": "A feature imports only core/ and shared/ (its own files relatively); screens compose features."
                  },
                  {
                    "group": [
                      "@/lib/**",
                      "@/components/**",
                      "@/routes/**",
                      "@/context/**",
                      "@/features/coach/**",
                      "@/features/conversation/**",
                      "@/features/memory/**",
                      "@/features/practice/**",
                      "@/features/settings/**",
                      "@/features/coach",
                      "@/features/conversation",
                      "@/features/memory",
                      "@/features/practice",
                      "@/features/settings"
                    ],
                    "message": "New layers never import legacy folders; migrate the code first (docs/engineering/MIGRATION.md)."
                  },
                  {
                    "group": ["@tauri-apps/api/core"],
                    "message": "Only core/ipc calls invoke(); use the Ipc service (EFFECT.md \u00a72)."
                  },
                  {
                    "group": ["@/core/*/**", "@/shared/*/*/**"],
                    "message": "Import the public API (`@/features/x`, `@/core/x`, `@/shared/ui/x`), not a deep path."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/screens/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/app/**", "@/screens/**", "@/app", "@/screens"],
                    "message": "A screen never imports app/ or another screen."
                  },
                  {
                    "group": [
                      "@/lib/**",
                      "@/components/**",
                      "@/routes/**",
                      "@/context/**",
                      "@/features/coach/**",
                      "@/features/conversation/**",
                      "@/features/memory/**",
                      "@/features/practice/**",
                      "@/features/settings/**",
                      "@/features/coach",
                      "@/features/conversation",
                      "@/features/memory",
                      "@/features/practice",
                      "@/features/settings"
                    ],
                    "message": "New layers never import legacy folders; migrate the code first (docs/engineering/MIGRATION.md)."
                  },
                  {
                    "group": ["@tauri-apps/api/core"],
                    "message": "Only core/ipc calls invoke(); use the Ipc service (EFFECT.md \u00a72)."
                  },
                  {
                    "group": ["@/features/*/**", "@/core/*/**", "@/shared/*/*/**"],
                    "message": "Import the public API (`@/features/x`, `@/core/x`, `@/shared/ui/x`), not a deep path."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/app/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@tauri-apps/api/core"],
                    "message": "Only core/ipc calls invoke(); use the Ipc service (EFFECT.md \u00a72)."
                  },
                  {
                    "group": ["@/features/*/**", "@/core/*/**", "@/shared/*/*/**"],
                    "message": "Import the public API (`@/features/x`, `@/core/x`, `@/shared/ui/x`), not a deep path."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
