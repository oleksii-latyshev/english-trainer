language js

or {
  `async function $name($args) { $body }`,
  `async ($args) => $body`,
  `try { $body } catch ($err) { $handler }`,
  `try { $body } catch { $handler }`
} as $node where {
  register_diagnostic(span=$node, message="Use Effect instead of async/await or try/catch here (CODE_REQUIREMENTS §3). Wrap a platform promise once in a core service with Effect.tryPromise.", severity="error")
}
